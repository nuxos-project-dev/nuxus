#!/usr/bin/env bash

QEMU_ARGS=(
  -M virt
  -cpu cortex-a57
  -serial stdio
  -device ramfb
  -drive file=QEMU_EFI.qcow2,format=qcow2,if=pflash,readonly=on
  -drive file=QEMU_VARS.qcow2,format=qcow2,if=pflash
  -drive file=fat:rw:esp,format=raw
)

cp ../build/lunix.efi esp/EFI/BOOT/BOOTAA64.EFI
cp QEMU_VARS.qcow2.bak QEMU_VARS.qcow2

qemu-system-aarch64 "${QEMU_ARGS[@]}"

rm -f esp/EFI/BOOT/BOOTAA64.EFI
rm QEMU_VARS.qcow2
